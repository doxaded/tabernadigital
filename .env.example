# ==========================================
# TABERNA DIGITAL — CONFIGURAÇÃO DO FIREBASE
# ==========================================
# Copie este arquivo para .env e preencha com as credenciais do seu projeto Firebase Console:
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY="sua_api_key_do_firebase"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="seu_sender_id"
VITE_FIREBASE_APP_ID="seu_app_id"

# Chave opcional da API Google Gemini para Urd e Sketch Studio ao vivo:
# VITE_GEMINI_API_KEY="sua_gemini_api_key"
