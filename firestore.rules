rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Função auxiliar para verificar o SuperAdmin exclusivo da Taberna
    function isSuperAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'henrique.v.berbert@gmail.com';
    }

    // Função para verificar se o usuário autenticado está aprovado
    function isApprovedUser() {
      return request.auth != null && (
        isSuperAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'APPROVED'
      );
    }

    // Regras da Coleção de Usuários
    match /users/{userId} {
      // Qualquer usuário logado pode ler perfis públicos
      allow read: if request.auth != null;
      
      // O próprio usuário pode criar seu perfil inicial (sempre PENDING e role 'user', exceto se for Henrique)
      allow create: if request.auth != null && request.auth.uid == userId && (
        isSuperAdmin() || (
          request.resource.data.role == 'user' && 
          request.resource.data.status == 'PENDING' &&
          request.resource.data.email.lower() != 'henrique.v.berbert@gmail.com'
        )
      );
      
      // Apenas henrique.v.berbert@gmail.com pode alterar o campo status (aprovar/rejeitar/revogar) ou role
      allow update: if request.auth != null && (
        isSuperAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'role']))
      );
      
      allow delete: if isSuperAdmin();
    }

    // Chave de sala: o jogador é membro quando seu uid está na lista de jogadores da chave
    function isRoomMember(key) {
      return request.auth.uid in get(/databases/$(database)/documents/roomKeys/$(key)).data.playerIds;
    }

    // Regras de Campanhas (Salas de Jogo)
    match /campaigns/{campaignId} {
      // Leitura: mestre da sala, SuperAdmin ou jogadores que entraram com a chave da sala
      allow read: if isApprovedUser() && (
        isSuperAdmin() ||
        resource.data.masterId == request.auth.uid ||
        (resource.data.joinKey is string && isRoomMember(resource.data.joinKey))
      );
      
      // Criação permitida para aprovados (o SuperAdmin também sobe as salas padrão)
      allow create: if isApprovedUser() && (request.resource.data.masterId == request.auth.uid || isSuperAdmin());
      
      // Atualização: Mestre criador da sala ou SuperAdmin. Jogadores membros só podem alterar as fichas.
      allow update: if isApprovedUser() && (
        resource.data.masterId == request.auth.uid ||
        isSuperAdmin() ||
        (
          resource.data.joinKey is string &&
          isRoomMember(resource.data.joinKey) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sheets'])
        )
      );

      // Exclusão exclusiva do Mestre criador da sala ou SuperAdmin
      allow delete: if isApprovedUser() && (
        resource.data.masterId == request.auth.uid || isSuperAdmin()
      );
    }

    // Chaves de Sala (XXXX-XXXX): quem conhece a chave consegue ler (get) e entrar; listagem é restrita.
    // Limite de 8 jogadores por sala imposto aqui, no servidor.
    match /roomKeys/{roomKey} {
      allow get: if isApprovedUser();

      allow list: if isApprovedUser() && (
        isSuperAdmin() ||
        resource.data.masterId == request.auth.uid ||
        request.auth.uid in resource.data.playerIds
      );

      allow create: if isApprovedUser() && (
        isSuperAdmin() || request.resource.data.masterId == request.auth.uid
      ) && request.resource.data.playerIds.size() <= 8;

      allow update: if isApprovedUser() && (
        // Mestre ou SuperAdmin: gerencia a lista, sempre respeitando o limite
        (
          (resource.data.masterId == request.auth.uid || isSuperAdmin()) &&
          request.resource.data.playerIds.size() <= 8
        ) ||
        // Jogador entrando: adiciona somente a si mesmo, sem remover ninguém, até o limite de 8
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds', 'players']) &&
          request.resource.data.playerIds.size() <= 8 &&
          request.resource.data.playerIds.size() == resource.data.playerIds.size() + 1 &&
          request.resource.data.players.size() == request.resource.data.playerIds.size() &&
          request.resource.data.playerIds.hasAll(resource.data.playerIds) &&
          request.auth.uid in request.resource.data.playerIds &&
          !(request.auth.uid in resource.data.playerIds)
        ) ||
        // Jogador saindo: remove somente a si mesmo
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds', 'players']) &&
          request.resource.data.playerIds.size() == resource.data.playerIds.size() - 1 &&
          request.resource.data.players.size() == request.resource.data.playerIds.size() &&
          resource.data.playerIds.hasAll(request.resource.data.playerIds) &&
          request.auth.uid in resource.data.playerIds &&
          !(request.auth.uid in request.resource.data.playerIds)
        )
      );

      allow delete: if isApprovedUser() && (
        resource.data.masterId == request.auth.uid || isSuperAdmin()
      );
    }

    // Regras de Rascunhos do Sketch Studio (Protegidos por autor)
    match /sketches/{sketchId} {
      allow read: if isApprovedUser();
      allow create: if isApprovedUser();
      allow update, delete: if isApprovedUser() && (
        resource.data.authorId == request.auth.uid || isSuperAdmin()
      );
    }

    // Mensagens do Portal de Chats (Salões de Campanha e Sussurros)
    match /messages/{messageId} {
      allow read: if isApprovedUser() && (
        isSuperAdmin() ||
        resource.data.scope == 'campaign-public' ||
        (request.auth.uid in resource.data.participants) ||
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow create: if isApprovedUser() && request.auth.uid == request.resource.data.senderUid;
      allow update, delete: if isApprovedUser() && (
        resource.data.senderUid == request.auth.uid || isSuperAdmin()
      );
    }
  }
}
